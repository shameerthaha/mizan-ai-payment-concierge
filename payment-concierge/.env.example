# ── Payment Concierge — Environment variables ────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── ElevenLabs API Key ───────────────────────────────────────────────────────
# Obtain from ElevenLabs → Settings → API Keys
# Used to authenticate webhook calls from the ElevenLabs agent to this backend.
ELEVENLABS_API_KEY=

# ElevenLabs base URL (default: https://api.elevenlabs.io)
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# ElevenLabs published agent ID (set when the agent is deployed)
# ELEVENLABS_AGENT_ID=

# ── Server ───────────────────────────────────────────────────────────────────
# PC_HOST=0.0.0.0
# PC_PORT=8000
# PC_LOG_LEVEL=info

# ── Brain Engine ─────────────────────────────────────────────────────────────
# Backend: "fixture" (in-memory test data, default) or "db" (Pratibha's model)
# RULE_ENGINE_BACKEND=fixture
# DATABASE_URL=postgresql://user:***@localhost:5432/payment_concierge
# EXCEL_IMPORT_PATH=/data/exports/emirates_nbd_config.json
# DEFAULT_BANK_ID=EMIRATES_NBD

# ── CORS ─────────────────────────────────────────────────────────────────────
# PC_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000